{
  "objective": "Minimize crash-inducing testcases while preserving deterministic reproduction",
  "environment": "ios_research_minimizer",
  "primary_metric": "median_input_reduction",
  "metrics": [
    {"name": "median_input_reduction", "direction": "maximize", "unit": "ratio"},
    {"name": "reproduction_rate", "direction": "maximize", "unit": "ratio"},
    {"name": "minimization_time_seconds", "direction": "minimize", "unit": "seconds"},
    {"name": "remaining_semantic_structure", "direction": "maximize", "unit": "ratio"}
  ],
  "constraints": [
    {
      "metric": "reproduction_rate",
      "op": ">=",
      "value": 0.99,
      "hard": true,
      "description": "Minimization must preserve the original failure"
    }
  ],
  "safety_rules": ["max-knobs:3"],
  "budget": {
    "max_experiments_per_batch": 6,
    "max_parallel": 4,
    "max_experiments_total": 60,
    "max_cost_usd": 100.0,
    "max_cost_usd_per_batch": 20.0
  }
}
