{
  "id": "iosr-crash-deduplication-simulator-v1",
  "objective": "Maximize accurate crash deduplication while minimizing false merges and false splits",
  "environment": "ios_research_crash_analysis",
  "primary_metric": "deduplication_f1",
  "metrics": [
    {"name": "deduplication_f1", "direction": "maximize", "unit": "ratio"},
    {"name": "false_merge_rate", "direction": "minimize", "unit": "ratio"},
    {"name": "false_split_rate", "direction": "minimize", "unit": "ratio"},
    {"name": "analysis_latency_ms", "direction": "minimize", "unit": "ms"}
  ],
  "constraints": [
    {
      "metric": "false_merge_rate",
      "op": "<=",
      "value": 0.02,
      "hard": true,
      "description": "Distinct vulnerabilities must not be collapsed"
    },
    {
      "metric": "false_split_rate",
      "op": "<=",
      "value": 0.05,
      "hard": true,
      "description": "Equivalent crashes should normally be grouped"
    }
  ],
  "safety_rules": ["max-knobs:3"],
  "budget": {
    "max_experiments_per_batch": 6,
    "max_parallel": 4,
    "max_experiments_total": 60,
    "max_cost_usd": 100.0,
    "max_cost_usd_per_batch": 20.0
  }
}
