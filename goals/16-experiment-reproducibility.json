{
  "id": "iosr-experiment-reproducibility-gate-v1",
  "objective": "Maximize reproducibility of ios-research experiments across repeated executions",
  "environment": "ios_research",
  "primary_metric": "experiment_reproducibility",
  "metrics": [
    {"name": "experiment_reproducibility", "direction": "maximize", "unit": "ratio"},
    {"name": "artifact_completeness", "direction": "maximize", "unit": "ratio"},
    {"name": "seed_consistency", "direction": "maximize", "unit": "ratio"},
    {"name": "environment_drift_rate", "direction": "minimize", "unit": "ratio"}
  ],
  "constraints": [
    {
      "metric": "artifact_completeness",
      "op": ">=",
      "value": 0.99,
      "hard": true,
      "description": "Experiments must preserve sufficient evidence for reproduction"
    }
  ],
  "safety_rules": ["no-destructive-device-operations"],
  "budget": {
    "max_experiments_per_batch": 5,
    "max_parallel": 3,
    "max_experiments_total": 50,
    "max_cost_usd": 100.0,
    "max_cost_usd_per_batch": 20.0
  }
}
