{
  "id": "iosr-cli-performance-gate-v1",
  "objective": "Reduce ios-research CLI latency and resource consumption without reducing correctness",
  "environment": "ios_research_cli",
  "primary_metric": "p95_command_latency_ms",
  "metrics": [
    {"name": "p95_command_latency_ms", "direction": "minimize", "unit": "ms"},
    {"name": "memory_mb", "direction": "minimize", "unit": "mb"},
    {"name": "cpu_percent", "direction": "minimize", "unit": "percent"},
    {"name": "command_success_rate", "direction": "maximize", "unit": "ratio"}
  ],
  "constraints": [
    {
      "metric": "command_success_rate",
      "op": ">=",
      "value": 0.999,
      "hard": true,
      "description": "Performance changes cannot reduce correctness"
    }
  ],
  "safety_rules": ["max-knobs:3"],
  "budget": {
    "max_experiments_per_batch": 6,
    "max_parallel": 4,
    "max_experiments_total": 60,
    "max_cost_usd": 100.0,
    "max_cost_usd_per_batch": 15.0
  }
}
