<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Lets a same-user binary-instrumentation fuzzer (Jackalope/TinyInst) obtain
     this harness's task port, exactly like an Xcode debug build. Only the
     harness is signed with it; no system binary is touched. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.get-task-allow</key>
    <true/>
</dict>
</plist>
